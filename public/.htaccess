# Lander: static admin UI, /api/* goes to index.php
Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^$ /login.html [R=302,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/ index.php [L,QSA]
RewriteRule ^health$ index.php [L]
# Kurz-URLs wie in Orbiter (/dashboard → /dashboard.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z-]+)$ index.php [L,QSA]
# admin pages are sent through PHP: nonce + Content-Security-Policy (see index.php)
RewriteRule ^[a-z0-9-]+\.html$ index.php [L,QSA]
<FilesMatch "\.(pod|sqlite|db|json\.bak|md)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  # Always revalidate the UI (ETag), otherwise old and new scripts mix after an update
  <FilesMatch "\.(html|js|css)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
</IfModule>
