# Lander in a subfolder (e.g. example.at/lander/): only public/ is reachable from the web.
# src/, data/ (the SQL file!), bin/ and lander.config.php can never be requested this way.
# On a subdomain whose document root is public/, this file is not needed.
Options -Indexes
RewriteEngine On
RewriteCond $1 !^public(/|$)
RewriteRule ^(.*)$ public/$1 [L]
